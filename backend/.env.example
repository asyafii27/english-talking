APP_PORT=8081
# gemini atau groq
AI_PROVIDER=gemini
AI_API_KEY=replace_with_your_key
AI_MODEL=gemini-2.5-flash
FRONTEND_ORIGIN=http://localhost:5173

# Database configuration (PostgreSQL)
DB_HOST=localhost
# 5433 = Postgres Docker dari host (go run lokal). Di dalam Docker otomatis pakai postgres:5432.
DB_PORT=5433
DB_USER=english_user
DB_PASSWORD=english_password
DB_NAME=english_conversation
DB_SSLMODE=disable
